# Database
DATABASE_URL="postgresql://user:password@host:5432/database"

# Session (generate with: openssl rand -base64 32)
SESSION_SECRET="your-long-random-secret-key-here"

# Admin emails (comma-separated)
ADMIN_EMAILS="your-email@example.com"

# Setup secret for initial database seeding (generate with: openssl rand -base64 32)
SETUP_SECRET="your-setup-secret-key-here"

# Email (for sending alerts - optional for now)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="AddDropper <noreply@yourdomain.com>"
