# =============================================================================
# EnrollEagle — Production environment variables
# Copy to .env and fill in real values before deploying.
# =============================================================================

# ---------- Database (RDS PostgreSQL) ----------
DATABASE_URL=postgresql+psycopg://enrolleagle:STRONG_PASSWORD@your-rds-endpoint.region.rds.amazonaws.com:5432/enrolleagle

# ---------- Frontend origin (for CORS / cookie domain) ----------
FRONTEND_URL=https://enrolleagle.example.com

# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://api.enrolleagle.example.com/auth/google/callback

# ---------- Sessions ----------
SESSION_SECRET=generate-a-long-random-string-at-least-32-bytes
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_NAME=enrolleagle_session
OAUTH_STATE_COOKIE_NAME=enrolleagle_oauth_state
SESSION_SAME_SITE=None
COOKIE_SECURE=true

# ---------- Cron / Polling ----------
CRON_SECRET=generate-a-separate-strong-secret
CRON_BATCH_SIZE=100
MAX_ACTIVE_WATCHES=20
DEFAULT_CADENCE_SECONDS=120

# ---------- Email (AWS SES) ----------
EMAIL_PROVIDER=ses
SES_FROM_EMAIL=alerts@enrolleagle.example.com

# ---------- Report HMAC ----------
REPORT_HMAC_SECRET=generate-another-strong-secret

# ---------- Environment ----------
ENV=production

# ---------- Frontend build arg (used by Web Dockerfile) ----------
VITE_API_BASE_URL=https://api.enrolleagle.example.com
