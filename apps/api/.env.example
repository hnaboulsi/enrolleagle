DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/enrolleagle
FRONTEND_URL=http://localhost:5173

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

SESSION_SECRET=replace-with-long-random-secret
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_NAME=enrolleagle_session
OAUTH_STATE_COOKIE_NAME=enrolleagle_oauth_state
SESSION_SAME_SITE=Lax
COOKIE_SECURE=false

CRON_SECRET=replace-with-strong-cron-secret
CRON_BATCH_SIZE=100
MAX_ACTIVE_WATCHES=20
DEFAULT_CADENCE_SECONDS=120

EMAIL_PROVIDER=ses
SES_FROM_EMAIL=alerts@example.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=alerts@example.com

REPORT_HMAC_SECRET=replace-with-report-hmac-secret
