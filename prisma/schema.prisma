generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WatchStatus {
  ACTIVE
  PAUSED
  DELETED
}

enum ProviderState {
  OPEN
  CLOSED
  UNKNOWN
}

enum AlertType {
  SEATS_OPENED
  WAITLIST_CHANGED
  STATE_CHANGED
}

enum LogLevel {
  INFO
  WARN
  ERROR
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  watchItems   WatchItem[]
}

model College {
  id         String        @id @default(cuid())
  name       String
  slug       String        @unique
  adapterKey String
  createdAt  DateTime      @default(now())
  watchItems WatchItem[]
  logs       ProviderLog[]
}

model WatchItem {
  id                  String        @id @default(cuid())
  userId              String
  collegeId           String
  term                String
  subject             String?
  catalogNumber       String?
  courseTitle         String?
  sectionLabel        String?
  externalSectionId   String
  externalUrl         String?
  status              WatchStatus   @default(ACTIVE)
  lastCheckedAt       DateTime?
  lastKnownSeats      Int?
  lastKnownWaitlist   Int?
  lastKnownState      ProviderState @default(UNKNOWN)
  consecutiveFailures Int           @default(0)
  lastErrorAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  user      User     @relation(fields: [userId], references: [id])
  college   College  @relation(fields: [collegeId], references: [id])
  alerts    AlertEvent[]
  logs      ProviderLog[]

  @@index([userId, status])
  @@index([collegeId, status])
}

model AlertEvent {
  id          String    @id @default(cuid())
  watchItemId String
  type        AlertType
  payload     Json
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  watchItem WatchItem @relation(fields: [watchItemId], references: [id])

  @@index([watchItemId, createdAt])
}

model ProviderLog {
  id          String    @id @default(cuid())
  collegeId   String?
  watchItemId String?
  level       LogLevel
  message     String
  meta        Json
  createdAt   DateTime @default(now())

  college   College?   @relation(fields: [collegeId], references: [id])
  watchItem WatchItem? @relation(fields: [watchItemId], references: [id])

  @@index([createdAt])
}
